# Public source roots are explicit: this workspace also holds private archives.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.nvmrc
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/SECURITY.md
!/AGENTS.md
!/requirements-build.txt
!/启动游戏.cmd
!/apps/
!/docs/
!/scripts/
!/.github/

**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db
**/server-data/
**/.chrome-*/
**/.release-check/
**/artifacts/
**/dist/
**/build/
**/coverage/
**/*.log
**/*.apk
**/*.idsig
**/*.zip

# Credentials and machine-specific configuration.
**/.env
**/.env.*
!**/.env.example
**/.ssh/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.pass
**/local.properties
**/players.json
**/*.sqlite*
**/*.db
